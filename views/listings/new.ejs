 <% layout ("/layouts/boilerplate") %>
    <div class="row " >
        <div class="col-8 offset-2">
             <h3>Create new listing</h3>
    <form method="post" action="/listings">
        <div class="mb-3">
            <label for="Title" class="form-label">Enter Title</label>
            <input name="Listing[title]" placeholder="enter the title" type="text" class="form-control">
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>   
            <textarea name="Listing[description]" placeholder="enter the description" class="form-control"></textarea>
        </div>
         <div class="mb-3">
            <label for="image" class="form-label">Image</label>
             <input name="Listing[image]" placeholder="enter the image url" type="text" class="form-control">
        </div>
        <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="Listing[price]" placeholder="enter the price" type="number" class="form-control">
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="Listing[country]" placeholder="enter your country" type="text" class="form-control">
        </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="Listing[location]" placeholder="enter your location" type="text" class="form-control">
        </div>
        <button class="btn btn-dark add-btn ">add</button>

    </form>
    </div>
</div>